    {"key": "meenakshi", "phone": "+919000001106", "language": "ta", "name": "Meenakshi Sundaram", "name_native": "மீனாட்சி சுந்தரம்", "village": "Thanjavur", "district": "Thanjavur", "state": "Tamil Nadu", "craft_type": "Tanjore painting", "years_practice": 19, "gender": "female", "cluster": "Tanjore painting artisans, Thanjavur", "gi_tag": "Thanjavur Paintings", "pehchan_id": "TN00047514", "verified": true, "new_artisan": false, "story_text": "தங்க இலை ஒட்டி, கற்கள் பதித்து கிருஷ்ணரை வரைகிறேன். ஒரு ஓவியத்திற்கு வாரங்கள் ஆகும்."},
