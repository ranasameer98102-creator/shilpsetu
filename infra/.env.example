# Copy to infra/.env and edit. Every provider defaults to a mock so the stack runs with no keys.
# Never commit real secrets.

ENV=dev
PUBLIC_BASE_URL=http://localhost:8000
# Local (no Docker) dev uses SQLite automatically; docker-compose overrides this with PostgreSQL.
# DATABASE_URL=postgresql+psycopg://shilpsetu:shilpsetu@localhost:5432/shilpsetu

# --- Security (generate real values for anything beyond a demo) ---
JWT_SECRET=dev-only-change-me-please-0123456789abcdef
# Fernet key for PII at rest:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=
# Ed25519 PEM for signing provenance certificates (auto-generated in dev if empty)
CERT_SIGNING_KEY_PATH=

# --- Provider switches (mock | real adapter) ---
ASR_PROVIDER=mock            # mock | bhashini | ai4bharat
NLU_PROVIDER=mock            # mock | claude
TRANSLATION_PROVIDER=mock    # mock | bhashini | indictrans2
STORAGE_PROVIDER=local       # local | s3
SMS_PROVIDER=mock            # mock | twilio | exotel
IVR_PROVIDER=mock            # mock | twilio | exotel
PAYMENT_PROVIDER=mock        # mock | razorpay
ONDC_MODE=mock               # mock | sandbox | production
JOB_MODE=inline              # sync | inline | rq
BACKGROUND_REMOVAL=auto      # auto | rembg | grabcut | off
REMBG_MODEL=u2net            # u2net (best, 176 MB) | u2netp (4.6 MB, for small servers)

# --- Bhashini (ULCA) — https://bhashini.gov.in/ulca ---
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd

# --- Self-hosted AI4Bharat models ---
AI4BHARAT_ASR_URL=           # e.g. http://indic-asr:8500/transcribe  (IndicConformer / IndicWhisper)
INDICTRANS2_URL=             # e.g. http://indictrans2:8600/translate

# --- LLM listing generation (NLU_PROVIDER=claude) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5

# --- Object storage (MinIO in docker-compose) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=shilpsetu-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- Redis (JOB_MODE=rq) ---
REDIS_URL=redis://localhost:6379/0

# --- SMS / IVR ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=

# --- Payments (Razorpay test mode) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- ONDC / Beckn BPP ---
ONDC_SUBSCRIBER_ID=shilpsetu.local
ONDC_SUBSCRIBER_URI=http://localhost:8000/ondc
ONDC_UNIQUE_KEY_ID=shilpsetu-key-1
ONDC_SIGNING_PRIVATE_KEY=    # base64 Ed25519 private key registered with the ONDC registry
ONDC_GATEWAY_URL=http://localhost:8000/ondc-mock/gateway
ONDC_DOMAIN=ONDC:RET12
ONDC_CITY=std:0141

# --- Business defaults (editable in Admin > Settings) ---
DEFAULT_COMMISSION_PCT=6
DEFAULT_FAIR_WAGE_PER_HOUR=100
TEAM_ID=[Your Team ID]
